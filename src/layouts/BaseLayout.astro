---
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/global.css';
import '../styles/utilities.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  appendBrand?: boolean;
  navigation?: 'reference' | 'homepage';
}
const { title, description, noindex = false, appendBrand = true, navigation = 'reference' } = Astro.props;
const pageTitle = appendBrand ? `${title} | The Ramaekers Group` : title;
const canonical = new URL(Astro.url.pathname, 'https://ramaekersgroup.com');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Ramaekers Group" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Header mode={navigation} />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer mode={navigation} />
  </body>
</html>
