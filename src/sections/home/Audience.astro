---
import SectionHeading from '../../components/SectionHeading.astro';
---
<section id="who-we-serve" class="section" data-theme="ivory" aria-labelledby="audience-title">
  <div class="container home-split">
    <SectionHeading id="audience-title" eyebrow="Who we serve" title="Built for Serious Operators"><p>We work with executives committed to disciplined execution and measurable results, with a primary focus on established middle-market manufacturing and construction businesses.</p></SectionHeading>
    <div class="home-audience-list">
      <div class="stack"><h3 class="type-h4">CEOs, Owners, and Presidents</h3><p>Leaders who want a clearer connection between the direction they set and the performance their business delivers.</p></div>
      <div class="stack"><h3 class="type-h4">Manufacturing Companies</h3><p>Businesses managing the relationship between capacity, productivity, inventory, cost, and margin.</p></div>
      <div class="stack"><h3 class="type-h4">Construction Companies</h3><p>Businesses where project execution, cash timing, cost control, and management accountability must work together.</p></div>
    </div>
  </div>
</section>
