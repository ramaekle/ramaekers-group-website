# Public browser configuration only. No private API key belongs here.
# Disabled until the owner approves activation and the PostHog draft is verified.
PUBLIC_HERO_EXPERIMENT_ENABLED=false
PUBLIC_POSTHOG_PROJECT_TOKEN=phc_REPLACE_WITH_DEVELOPMENT_PROJECT_TOKEN
PUBLIC_POSTHOG_API_HOST=https://us.i.posthog.com
PUBLIC_ANALYTICS_ENVIRONMENT=development
# Explicit host allowlist; production mode additionally permits only the two public domains.
PUBLIC_POSTHOG_ALLOWED_HOSTS=localhost,127.0.0.1
# Use a separate production project/token in the production build configuration.
